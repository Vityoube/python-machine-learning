   "source": [
    "from sklearn.datasets import load_iris\n",
    "from sklearn.tree  import DecisionTreeClassifier\n",
    "\n",
    "iris = load_iris()\n",
    "x = iris.data\n",
    "y = iris.target\n",
    "\n",
    "model = DecisionTreeClassifier()\n",
    "model.fit(x, y)\n",
    "\n",
    "new_flower = [[5.0, 3.4, 1.5, 0.2]]\n",
    "prediction = model.predict(new_flower)\n",
    "print(prediction)"
   ],
